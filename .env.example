# SolarFlow ERP - Environment Variables Template
# Copy this file to .env and configure your local environment credentials

# Database Configuration (PostgreSQL)
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=your_secure_db_password_here
PGDATA=/var/lib/postgresql/data/pgdata

# Odoo Server Configuration
HOST=db
USER=odoo
PASSWORD=your_secure_db_password_here
ADMIN_PASSWD=your_master_superadmin_password_here

# Network Ports
PORT_WEB=8069
PORT_LONGPOLLING=8072
