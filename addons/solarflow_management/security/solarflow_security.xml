<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="module_solarflow_category">
        <field name="name">SolarFlow ERP Roles</field>
        <field name="description">Role-Based Access Control (RBAC) for SolarFlow Solar EPC System</field>
        <field name="sequence">15</field>
    </record>

    <!-- ===================================================================== -->
    <!-- 8 ENTERPRISE ROLES FOR SOLAR EPC                                      -->
    <!-- ===================================================================== -->

    <!-- 1. Survey Technician -->
    <record id="group_solarflow_survey_technician" model="res.groups">
        <field name="name">Survey Technician</field>
        <field name="category_id" ref="module_solarflow_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Performs rooftop assessments, logs pitch/azimuth/shadow, and submits surveys. Cannot approve surveys or view financial reports.</field>
    </record>

    <!-- 2. Installation Technician -->
    <record id="group_solarflow_technician" model="res.groups">
        <field name="name">Installation Technician</field>
        <field name="category_id" ref="module_solarflow_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Executes assigned rooftop installations, 6-phase checklist, and electrical QC testing (Voc, Isc, Earth &lt;= 5.0 Ohm). Cannot view financial reports or unrelated projects.</field>
    </record>

    <!-- 3. Sales Manager -->
    <record id="group_solarflow_sales_manager" model="res.groups">
        <field name="name">Sales Manager</field>
        <field name="category_id" ref="module_solarflow_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Manages customer enquiries, leads, follow-ups, survey requests, quotations, and sales contracts. Cannot modify inventory stock or financial configurations.</field>
    </record>

    <!-- 4. Warehouse Manager -->
    <record id="group_solarflow_warehouse_manager" model="res.groups">
        <field name="name">Warehouse Manager</field>
        <field name="category_id" ref="module_solarflow_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Manages products, inventory receipts, reservations, serialized hardware allocation, and site dispatches. Cannot edit sales pricing or financial settings.</field>
    </record>

    <!-- 5. Support Manager -->
    <record id="group_solarflow_support_manager" model="res.groups">
        <field name="name">Support Manager</field>
        <field name="category_id" ref="module_solarflow_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Handles after-sales service tickets, complaints, serial warranty lookup, replacement parts, and technician assignment.</field>
    </record>

    <!-- 6. Finance Manager -->
    <record id="group_solarflow_finance_manager" model="res.groups">
        <field name="name">Finance Manager</field>
        <field name="category_id" ref="module_solarflow_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Manages milestone invoices, payments, project expenses, and job costing profitability sheets. Cannot modify system configurations or user accounts.</field>
    </record>

    <!-- 7. Director / Investor (Strict Read-Only) -->
    <record id="group_solarflow_director" model="res.groups">
        <field name="name">Director / Investor</field>
        <field name="category_id" ref="module_solarflow_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Executive read-only access to business performance dashboards, revenue, EBITDA gross margins, project profitability, and operational reports. Cannot create, edit or delete business records.</field>
    </record>

    <!-- 8. Super Administrator (Full System Access) -->
    <record id="group_solarflow_admin" model="res.groups">
        <field name="name">Super Administrator</field>
        <field name="category_id" ref="module_solarflow_category"/>
        <field name="implied_ids" eval="[
            (4, ref('group_solarflow_survey_technician')),
            (4, ref('group_solarflow_technician')),
            (4, ref('group_solarflow_sales_manager')),
            (4, ref('group_solarflow_warehouse_manager')),
            (4, ref('group_solarflow_support_manager')),
            (4, ref('group_solarflow_finance_manager')),
            (4, ref('group_solarflow_director'))
        ]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Full administrative control over all business modules, security settings, users, roles, and system configurations.</field>
    </record>

    <!-- Compatibility aliases -->
    <record id="group_solarflow_user" model="res.groups">
        <field name="name">SolarFlow Standard User</field>
        <field name="category_id" ref="module_solarflow_category"/>
        <field name="implied_ids" eval="[(4, ref('group_solarflow_sales_manager'))]"/>
    </record>

    <record id="group_solarflow_engineer" model="res.groups">
        <field name="name">SolarFlow Engineer</field>
        <field name="category_id" ref="module_solarflow_category"/>
        <field name="implied_ids" eval="[(4, ref('group_solarflow_sales_manager'))]"/>
    </record>

    <record id="group_solarflow_manager" model="res.groups">
        <field name="name">SolarFlow Operations Manager</field>
        <field name="category_id" ref="module_solarflow_category"/>
        <field name="implied_ids" eval="[(4, ref('group_solarflow_admin'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- ===================================================================== -->
    <!-- RECORD RULES                                                          -->
    <!-- ===================================================================== -->

    <!-- Rule 1: Survey Technicians only view assigned site surveys -->
    <record id="rule_solarflow_survey_technician" model="ir.rule">
        <field name="name">Survey Technician: Assigned Surveys Only</field>
        <field name="model_id" ref="model_solarflow_survey"/>
        <field name="domain_force">['|', ('surveyor_id', '=', user.id), ('surveyor_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('group_solarflow_survey_technician'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Rule 2: Installation Technicians only view assigned installation projects -->
    <record id="rule_solarflow_installation_technician" model="ir.rule">
        <field name="name">Technician: View Assigned Installations Only</field>
        <field name="model_id" ref="model_solarflow_installation"/>
        <field name="domain_force">['|', ('technician_id', '=', user.id), ('technician_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('group_solarflow_technician'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Rule 3: Managers & Admins view all installations (Full Access) -->
    <record id="rule_solarflow_installation_admin_managers" model="ir.rule">
        <field name="name">Administrator &amp; Managers: Manage All Installations</field>
        <field name="model_id" ref="model_solarflow_installation"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[
            (4, ref('group_solarflow_admin')),
            (4, ref('group_solarflow_sales_manager')),
            (4, ref('group_solarflow_support_manager')),
            (4, ref('group_solarflow_warehouse_manager')),
            (4, ref('group_solarflow_finance_manager'))
        ]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Rule 4: Director: Read-Only Installations (Strictly No Write/Create/Unlink) -->
    <record id="rule_solarflow_installation_director_readonly" model="ir.rule">
        <field name="name">Director: View All Installations Read-Only</field>
        <field name="model_id" ref="model_solarflow_installation"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_solarflow_director'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Rule 5: Project Costing: Finance Manager & Admin (Manage Access) -->
    <record id="rule_solarflow_cost_finance_admin" model="ir.rule">
        <field name="name">Project Costing: Finance and Administrator Manage</field>
        <field name="model_id" ref="model_solarflow_project_cost"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[
            (4, ref('group_solarflow_finance_manager')),
            (4, ref('group_solarflow_admin'))
        ]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Rule 6: Project Costing: Director Read-Only (Strictly No Write/Create/Unlink) -->
    <record id="rule_solarflow_cost_director_readonly" model="ir.rule">
        <field name="name">Project Costing: Director View Read-Only</field>
        <field name="model_id" ref="model_solarflow_project_cost"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_solarflow_director'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
