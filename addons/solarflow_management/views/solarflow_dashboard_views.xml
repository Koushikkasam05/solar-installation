<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Server Action to open the Singleton Dashboard -->
    <record id="action_solarflow_dashboard_server" model="ir.actions.server">
        <field name="name">SolarFlow Executive Dashboard</field>
        <field name="model_id" ref="model_solarflow_dashboard"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_dashboard()</field>
    </record>

    <!-- Dashboard Form View -->
    <record id="view_solarflow_dashboard_form" model="ir.ui.view">
        <field name="name">solarflow.dashboard.form</field>
        <field name="model">solarflow.dashboard</field>
        <field name="arch" type="xml">
            <form string="Executive Command Center" create="false" delete="false">
                <sheet>
                    <div class="oe_title mb-4">
                        <h1 class="text-primary fw-bold">
                            <i class="fa fa-sun-o text-warning me-2"/> SolarFlow ERP Executive Operations Dashboard
                        </h1>
                        <p class="text-muted">
                            Live real-time operational metrics across Sales, EPC Field Execution, Inventory, Digital Warranties, and Gross Project Profitability.
                        </p>
                    </div>

                    <!-- 12 Real Database-Driven KPI Cards -->
                    <div class="o_horizontal_separator text-uppercase fw-bold text-secondary my-3">
                        <i class="fa fa-bolt me-1"/> EPC Pipeline &amp; Field Execution KPIs
                    </div>
                    <div class="row g-3 mb-4">
                        <!-- 1. Total Projects -->
                        <div class="col-12 col-sm-6 col-md-3">
                            <button name="action_view_total_projects" type="object" class="btn btn-outline-primary w-100 p-3 text-start shadow-sm rounded border">
                                <div class="text-muted small text-uppercase fw-semibold">Total Projects</div>
                                <div class="fs-2 fw-bold text-primary"><field name="total_projects"/></div>
                                <div class="text-muted small"><i class="fa fa-cubes me-1"/> Commissioning sites</div>
                            </button>
                        </div>
                        <!-- 2. Pending Customer Leads -->
                        <div class="col-12 col-sm-6 col-md-3">
                            <button name="action_view_pending_leads" type="object" class="btn btn-outline-info w-100 p-3 text-start shadow-sm rounded border">
                                <div class="text-muted small text-uppercase fw-semibold">Pending Leads</div>
                                <div class="fs-2 fw-bold text-info"><field name="pending_leads"/></div>
                                <div class="text-muted small"><i class="fa fa-user-plus me-1"/> Solar inquiries</div>
                            </button>
                        </div>
                        <!-- 3. Pending Site Surveys -->
                        <div class="col-12 col-sm-6 col-md-3">
                            <button name="action_view_pending_surveys" type="object" class="btn btn-outline-warning w-100 p-3 text-start shadow-sm rounded border">
                                <div class="text-muted small text-uppercase fw-semibold">Pending Surveys</div>
                                <div class="fs-2 fw-bold text-warning"><field name="pending_surveys"/></div>
                                <div class="text-muted small"><i class="fa fa-map-marker me-1"/> Rooftop assessments</div>
                            </button>
                        </div>
                        <!-- 4. Pending Quotations -->
                        <div class="col-12 col-sm-6 col-md-3">
                            <button name="action_view_pending_quotations" type="object" class="btn btn-outline-secondary w-100 p-3 text-start shadow-sm rounded border">
                                <div class="text-muted small text-uppercase fw-semibold">Pending Quotations</div>
                                <div class="fs-2 fw-bold text-dark"><field name="pending_quotations"/></div>
                                <div class="text-muted small"><i class="fa fa-file-text-o me-1"/> Awaiting customer sign</div>
                            </button>
                        </div>

                        <!-- 5. Confirmed Sales Orders -->
                        <div class="col-12 col-sm-6 col-md-3">
                            <button name="action_view_confirmed_orders" type="object" class="btn btn-outline-success w-100 p-3 text-start shadow-sm rounded border">
                                <div class="text-muted small text-uppercase fw-semibold">Confirmed Orders</div>
                                <div class="fs-2 fw-bold text-success"><field name="confirmed_orders"/></div>
                                <div class="text-muted small"><i class="fa fa-check-circle me-1"/> Signed solar contracts</div>
                            </button>
                        </div>
                        <!-- 6. Scheduled Installations -->
                        <div class="col-12 col-sm-6 col-md-3">
                            <button name="action_view_scheduled_installations" type="object" class="btn btn-outline-primary w-100 p-3 text-start shadow-sm rounded border">
                                <div class="text-muted small text-uppercase fw-semibold">Scheduled Visits</div>
                                <div class="fs-2 fw-bold text-primary"><field name="scheduled_installations"/></div>
                                <div class="text-muted small"><i class="fa fa-calendar me-1"/> Crew dispatched</div>
                            </button>
                        </div>
                        <!-- 7. Completed Installations -->
                        <div class="col-12 col-sm-6 col-md-3">
                            <button name="action_view_completed_installations" type="object" class="btn btn-outline-success w-100 p-3 text-start shadow-sm rounded border">
                                <div class="text-muted small text-uppercase fw-semibold">Completed Projects</div>
                                <div class="fs-2 fw-bold text-success"><field name="completed_installations"/></div>
                                <div class="text-muted small"><i class="fa fa-star me-1"/> Energized &amp; accepted</div>
                            </button>
                        </div>
                        <!-- 8. Low Stock Products -->
                        <div class="col-12 col-sm-6 col-md-3">
                            <button name="action_view_low_stock_products" type="object" class="btn btn-outline-danger w-100 p-3 text-start shadow-sm rounded border">
                                <div class="text-muted small text-uppercase fw-semibold">Low Stock Products</div>
                                <div class="fs-2 fw-bold text-danger"><field name="low_stock_products"/></div>
                                <div class="text-muted small"><i class="fa fa-exclamation-triangle me-1"/> Reorder alerts</div>
                            </button>
                        </div>

                        <!-- 9. Active Warranties -->
                        <div class="col-12 col-sm-6 col-md-3">
                            <button name="action_view_active_warranties" type="object" class="btn btn-outline-info w-100 p-3 text-start shadow-sm rounded border">
                                <div class="text-muted small text-uppercase fw-semibold">Active Warranties</div>
                                <div class="fs-2 fw-bold text-info"><field name="active_warranties"/></div>
                                <div class="text-muted small"><i class="fa fa-shield me-1"/> Digital SHA-256 tokens</div>
                            </button>
                        </div>
                        <!-- 10. Open Service Tickets -->
                        <div class="col-12 col-sm-6 col-md-3">
                            <button name="action_view_open_service_tickets" type="object" class="btn btn-outline-warning w-100 p-3 text-start shadow-sm rounded border">
                                <div class="text-muted small text-uppercase fw-semibold">Open Service Tickets</div>
                                <div class="fs-2 fw-bold text-warning"><field name="open_service_tickets"/></div>
                                <div class="text-muted small"><i class="fa fa-life-ring me-1"/> Active RMA claims</div>
                            </button>
                        </div>
                        <!-- 11. Monthly Revenue -->
                        <div class="col-12 col-sm-6 col-md-3">
                            <button name="action_view_revenue" type="object" class="btn btn-outline-success w-100 p-3 text-start shadow-sm rounded border">
                                <div class="text-muted small text-uppercase fw-semibold">Monthly Revenue</div>
                                <div class="fs-3 fw-bold text-success"><field name="monthly_revenue" widget="monetary"/></div>
                                <div class="text-muted small"><i class="fa fa-line-chart me-1"/> Invoiced this month</div>
                            </button>
                        </div>
                        <!-- 12. Gross Project Profit -->
                        <div class="col-12 col-sm-6 col-md-3">
                            <button name="action_view_gross_profit" type="object" class="btn btn-outline-dark w-100 p-3 text-start shadow-sm rounded border">
                                <div class="text-muted small text-uppercase fw-semibold">Gross Project Profit</div>
                                <div class="fs-3 fw-bold text-dark"><field name="gross_project_profit" widget="monetary"/></div>
                                <div class="text-muted small"><i class="fa fa-balance-scale me-1"/> Gross project margin</div>
                            </button>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Installations Status Graph View -->
    <record id="view_solarflow_installation_graph" model="ir.ui.view">
        <field name="name">solarflow.installation.graph</field>
        <field name="model">solarflow.installation</field>
        <field name="arch" type="xml">
            <graph string="Installations by State" type="bar">
                <field name="state"/>
                <field name="installation_capacity_kw" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Installations Pivot View -->
    <record id="view_solarflow_installation_pivot" model="ir.ui.view">
        <field name="name">solarflow.installation.pivot</field>
        <field name="model">solarflow.installation</field>
        <field name="arch" type="xml">
            <pivot string="Solar Projects Execution Analysis">
                <field name="system_type" type="row"/>
                <field name="state" type="col"/>
                <field name="installation_capacity_kw" type="measure"/>
            </pivot>
        </field>
    </record>
</odoo>
