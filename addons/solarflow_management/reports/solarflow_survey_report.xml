<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_solarflow_survey_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page" style="font-family: Arial, sans-serif; color: #1e293b; padding: 30px;">
                    <div style="border-bottom: 3px solid #f59e0b; padding-bottom: 10px; margin-bottom: 20px;">
                        <h2 style="color: #1e3a8a; margin: 0;">SOLARFLOW ROOFTOP SITE SURVEY REPORT</h2>
                        <div style="display: flex; justify-content: space-between; margin-top: 8px;">
                            <span><strong>Survey Ref:</strong> <t t-esc="doc.name"/></span>
                            <span><strong>Status:</strong> <span style="background: #10b981; color: white; padding: 2px 6px; border-radius: 4px;"><t t-esc="doc.state.upper()"/></span></span>
                        </div>
                    </div>
                    <div style="display: flex; gap: 20px; margin-bottom: 20px;">
                        <div style="flex: 1; background: #f8fafc; padding: 15px; border-radius: 6px;">
                            <h4 style="margin-top: 0;">Customer Information</h4>
                            <p><strong>Name:</strong> <t t-esc="doc.partner_id.name"/></p>
                            <p><strong>Phone:</strong> <t t-esc="doc.partner_id.phone or 'N/A'"/></p>
                            <p><strong>Address:</strong> <t t-esc="doc.site_address or doc.partner_id.contact_address"/></p>
                        </div>
                        <div style="flex: 1; background: #f8fafc; padding: 15px; border-radius: 6px;">
                            <h4 style="margin-top: 0;">Technical Assessment</h4>
                            <p><strong>Surveyor:</strong> <t t-esc="doc.surveyor_id.name"/></p>
                            <p><strong>System Size:</strong> <span style="font-weight: bold; color: #f59e0b;"><t t-esc="doc.recommended_capacity_kw"/> kW</span> (<t t-esc="doc.system_type.upper()"/>)</p>
                            <p><strong>Usable Roof Area:</strong> <t t-esc="doc.usable_area_sqft"/> sq. ft.</p>
                        </div>
                    </div>
                    <h4>Calculated Bill of Materials (BOM)</h4>
                    <table style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr style="background: #1e3a8a; color: white;">
                                <th style="padding: 8px; text-align: left;">Category</th>
                                <th style="padding: 8px; text-align: left;">Component</th>
                                <th style="padding: 8px; text-align: center;">Qty</th>
                                <th style="padding: 8px; text-align: right;">Total Cost</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="doc.bom_line_ids" t-as="line">
                                <tr style="border-bottom: 1px solid #e2e8f0;">
                                    <td style="padding: 8px;"><t t-esc="line.category.upper()"/></td>
                                    <td style="padding: 8px;"><t t-esc="line.name"/></td>
                                    <td style="padding: 8px; text-align: center;"><t t-esc="line.quantity"/> <t t-esc="line.uom"/></td>
                                    <td style="padding: 8px; text-align: right;"><t t-esc="line.total_cost"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
