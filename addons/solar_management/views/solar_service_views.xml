<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_solar_service_ticket" model="ir.actions.act_window">
        <field name="name">Service Tickets</field>
        <field name="res_model">solar.service.ticket</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Manage After-Sales Service &amp; Maintenance!
            </p>
            <p>
                Log inverter error codes, generation loss issues, schedule module washings, and assign field repair technicians.
            </p>
        </field>
    </record>

    <record id="action_solar_amc_contract" model="ir.actions.act_window">
        <field name="name">AMC Contracts</field>
        <field name="res_model">solar.amc.contract</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Ticket Kanban View -->
    <record id="view_solar_service_ticket_kanban" model="ir.ui.view">
        <field name="name">solar.service.ticket.kanban</field>
        <field name="model">solar.service.ticket</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="issue_category"/>
                <field name="priority"/>
                <field name="technician_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click p-2 border rounded shadow-sm">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <strong><field name="name"/></strong>
                                <field name="priority" widget="priority"/>
                            </div>
                            <div class="mb-1"><field name="customer_id"/></div>
                            <div class="mb-1"><span class="badge bg-info"><field name="issue_category"/></span></div>
                            <small class="text-muted"><i class="fa fa-wrench"/> <field name="technician_id"/></small>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Ticket Form View -->
    <record id="view_solar_service_ticket_form" model="ir.ui.view">
        <field name="name">solar.service.ticket.form</field>
        <field name="model">solar.service.ticket</field>
        <field name="arch" type="xml">
            <form string="Solar Service &amp; Maintenance Ticket">
                <header>
                    <button name="action_assign" string="Dispatch Technician" type="object" class="btn-primary" invisible="state != 'new'"/>
                    <button name="action_start_service" string="Start Diagnosis" type="object" class="btn-secondary" invisible="state != 'assigned'"/>
                    <button name="action_resolve" string="Mark as Resolved" type="object" class="btn-success" invisible="state != 'in_progress'"/>
                    <button name="action_close" string="Close Ticket" type="object" class="btn-secondary" invisible="state != 'resolved'"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,assigned,in_progress,resolved,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Ticket ID"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Incident Classification">
                            <field name="customer_id"/>
                            <field name="installation_project_id"/>
                            <field name="issue_category"/>
                            <field name="inverter_error_code" invisible="issue_category != 'inverter_fault'"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group string="Technician &amp; Timeline">
                            <field name="technician_id"/>
                            <field name="scheduled_date"/>
                            <field name="resolved_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Issue Description">
                            <field name="description" placeholder="Customer complaint description..."/>
                        </page>
                        <page string="Technician Resolution Notes">
                            <field name="resolution_details" placeholder="Root cause diagnosis and corrective actions taken..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- AMC Form View -->
    <record id="view_solar_amc_contract_form" model="ir.ui.view">
        <field name="name">solar.amc.contract.form</field>
        <field name="model">solar.amc.contract</field>
        <field name="arch" type="xml">
            <form string="Annual Maintenance Contract (AMC)">
                <header>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="AMC-2026-CUSTOMER"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Agreement Scope">
                            <field name="customer_id"/>
                            <field name="installation_project_id"/>
                            <field name="contract_amount" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Cleaning &amp; Duration">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="annual_cleanings_planned"/>
                            <field name="cleanings_completed"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
