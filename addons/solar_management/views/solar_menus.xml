    <menuitem id="menu_solar_inventory_root"
              name="Serialized Inventory"
              parent="menu_solar_root"
              sequence="30"/>

    <menuitem id="menu_solar_serials"
              name="Component Serial Registry"
              parent="menu_solar_inventory_root"
              action="action_solar_serial_registry"
