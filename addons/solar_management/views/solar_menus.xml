<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root Solar EPC Menu -->
    <menuitem id="menu_solar_root"
              name="Solar EPC"
              web_icon="solar_management,static/description/icon.png"
              sequence="5"/>

    <!-- Operations & Projects -->
    <menuitem id="menu_solar_operations"
              name="Operations"
              parent="menu_solar_root"
              sequence="10"/>

    <menuitem id="menu_solar_projects"
              name="Installation Projects"
              parent="menu_solar_operations"
              action="action_solar_installation_project"
              sequence="10"/>

    <menuitem id="menu_solar_surveys"
              name="Site Surveys"
              parent="menu_solar_operations"
              action="action_solar_site_survey"
              sequence="20"/>

    <!-- Sales & Pre-Engineering -->
    <menuitem id="menu_solar_sales_root"
              name="Sales &amp; CRM"
              parent="menu_solar_root"
              sequence="20"/>

    <menuitem id="menu_solar_leads"
              name="Solar Opportunities"
              parent="menu_solar_sales_root"
              action="action_solar_crm_lead"
              sequence="10"/>

    <menuitem id="menu_solar_quotations"
              name="Solar Quotations"
              parent="menu_solar_sales_root"
              action="action_solar_quotations"
              sequence="20"/>

    <menuitem id="menu_solar_packages"
              name="Solar Packages &amp; Pricing"
              parent="menu_solar_sales_root"
              action="action_solar_package"
