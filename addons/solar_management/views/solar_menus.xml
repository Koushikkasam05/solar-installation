    <menuitem id="menu_solar_finance_root"
              name="Project Financials"
              parent="menu_solar_root"
              sequence="50"/>

    <menuitem id="menu_solar_costings"
              name="Job Costing &amp; Margins"
              parent="menu_solar_finance_root"
              action="action_solar_project_costing"
              sequence="10"/>

    <menuitem id="menu_solar_milestones"
              name="Payment Milestones"
              parent="menu_solar_finance_root"
              action="action_solar_payment_milestones"
              sequence="20"/>
