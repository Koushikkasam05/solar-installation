<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_solar_project_costing" model="ir.actions.act_window">
        <field name="name">Job Costing &amp; Profitability</field>
        <field name="res_model">solar.project.costing</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Analyze Solar Project Margins &amp; Execution Costs!
            </p>
            <p>
                Track BOM hardware, mounting structure, labor, DISCOM liaisoning fees, and net profit margins per installation.
            </p>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_solar_project_costing_tree" model="ir.ui.view">
        <field name="name">solar.project.costing.tree</field>
        <field name="model">solar.project.costing</field>
        <field name="arch" type="xml">
            <tree decoration-success="margin_status in ['high', 'healthy']" decoration-warning="margin_status == 'low'" decoration-danger="margin_status == 'loss'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="customer_id"/>
                <field name="system_capacity_kw" widget="badge"/>
                <field name="contract_revenue" widget="monetary"/>
                <field name="total_project_cost" widget="monetary"/>
                <field name="gross_profit" widget="monetary"/>
                <field name="profit_margin_pct" widget="badge"/>
                <field name="margin_status" widget="badge" decoration-success="margin_status == 'high'" decoration-warning="margin_status == 'healthy'"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_solar_project_costing_form" model="ir.ui.view">
        <field name="name">solar.project.costing.form</field>
        <field name="model">solar.project.costing</field>
        <field name="arch" type="xml">
            <form string="Project Job Costing &amp; Profitability">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Costing Sheet Ref"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Project Overview">
                            <field name="project_id"/>
                            <field name="customer_id"/>
                            <field name="system_capacity_kw"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Revenue Summary">
                            <field name="contract_revenue" widget="monetary"/>
                            <field name="revenue_per_watt"/>
                        </group>
                    </group>

                    <group string="Itemized Execution Cost Breakdown">
                        <group string="Materials &amp; Hardware">
                            <field name="bom_hardware_cost" widget="monetary"/>
                            <field name="structure_civil_cost" widget="monetary"/>
                            <field name="electrical_bos_cost" widget="monetary"/>
                        </group>
                        <group string="Labor, Transport &amp; Liaisoning">
                            <field name="labor_technician_cost" widget="monetary"/>
                            <field name="discom_liaisoning_cost" widget="monetary"/>
                            <field name="transportation_cost" widget="monetary"/>
                            <field name="contingency_cost" widget="monetary"/>
                        </group>
                    </group>

                    <group string="Profitability &amp; Financial Margins" class="oe_subtotal_footer_separator">
                        <group>
                            <field name="total_project_cost" widget="monetary"/>
                            <field name="cost_per_watt"/>
                        </group>
                        <group>
                            <field name="gross_profit" widget="monetary" class="oe_subtotal_footer_separator"/>
                            <field name="profit_margin_pct" widget="badge"/>
                            <field name="margin_status" widget="badge" decoration-success="margin_status in ['high', 'healthy']" decoration-danger="margin_status == 'loss'"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
</odoo>
