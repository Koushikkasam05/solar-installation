<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_solar_warranty_card" model="ir.actions.act_window">
        <field name="name">Digital Warranty Certificates</field>
        <field name="res_model">solar.warranty.card</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Manage Digital Warranty Certificates!
            </p>
            <p>
                Issue verifiable 25-year panel performance, 10-year inverter, and 5-year workmanship warranties with cryptographic verification tokens.
            </p>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_solar_warranty_card_tree" model="ir.ui.view">
        <field name="name">solar.warranty.card.tree</field>
        <field name="model">solar.warranty.card</field>
        <field name="arch" type="xml">
            <tree decoration-success="status == 'active'" decoration-warning="status == 'claim_in_progress'" decoration-muted="status == 'expired'">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="installation_project_id"/>
                <field name="warranty_type"/>
                <field name="oem_brand"/>
                <field name="duration_years"/>
                <field name="start_date"/>
                <field name="expiry_date"/>
                <field name="verification_hash"/>
                <field name="status" widget="badge" decoration-success="status == 'active'" decoration-warning="status == 'claim_in_progress'"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_solar_warranty_card_form" model="ir.ui.view">
        <field name="name">solar.warranty.card.form</field>
        <field name="model">solar.warranty.card</field>
        <field name="arch" type="xml">
            <form string="Solar Digital Warranty Certificate">
                <header>
                    <button name="action_file_claim" string="File Warranty Claim" type="object" class="btn-warning" invisible="status != 'active'"/>
                    <button name="action_resolve_claim" string="Resolve RMA Claim" type="object" class="btn-success" invisible="status != 'claim_in_progress'"/>
                    <field name="status" widget="statusbar" statusbar_visible="active,claim_in_progress,claim_resolved,expired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Warranty Certificate ID"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Beneficiary &amp; Project">
                            <field name="customer_id"/>
                            <field name="installation_project_id"/>
                            <field name="warranty_type"/>
                            <field name="oem_brand"/>
                        </group>
                        <group string="Coverage Period &amp; Token">
                            <field name="duration_years"/>
                            <field name="start_date"/>
                            <field name="expiry_date"/>
                            <field name="verification_hash" widget="badge"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Terms &amp; Coverage SLA">
                            <field name="terms_and_conditions" placeholder="Specify OEM performance guarantee clauses..."/>
                        </page>
                        <page string="RMA / Claim History">
                            <field name="claim_notes" placeholder="Log customer complaints, technician diagnosis, and RMA replacement parts..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
</odoo>
