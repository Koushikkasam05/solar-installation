<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Executive Dashboard Action -->
    <record id="action_solar_executive_dashboard" model="ir.actions.act_window">
        <field name="name">Solar Executive Dashboard</field>
        <field name="res_model">solar.installation.project</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_state': 'commissioned'}</field>
    </record>

    <!-- Top Level Dashboard Menu -->
    <menuitem id="menu_solar_dashboard"
              name="Dashboard"
              parent="menu_solar_root"
              action="action_solar_installation_project"
              sequence="1"/>
</odoo>
