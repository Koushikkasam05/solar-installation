<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_solar_warranty_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page" style="border: 12px double #1e3a8a; padding: 40px; margin: 20px; font-family: 'Georgia', serif; background-color: #fffdfa; color: #1f2937;">
                    <!-- Certificate Header -->
                    <div style="text-align: center; margin-bottom: 30px;">
                        <h1 style="color: #1e3a8a; font-size: 32px; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 5px;">CERTIFICATE OF WARRANTY</h1>
                        <h3 style="color: #d97706; font-style: italic; margin-top: 0;">Solar Photovoltaic Generation System</h3>
                        <p style="font-size: 14px; color: #6b7280;">Certificate No: <strong><t t-esc="doc.name"/></strong></p>
                    </div>

                    <!-- Beneficiary Details -->
                    <div style="text-align: center; margin: 30px 0; font-size: 18px; line-height: 1.8;">
                        <p>This certifies that the solar installation commissioned for</p>
                        <h2 style="color: #111827; text-decoration: underline; margin: 10px 0;"><t t-esc="doc.customer_id.name"/></h2>
                        <p>under Project Reference <strong><t t-esc="doc.installation_project_id.name"/></strong> is covered under our official</p>
                        <h3 style="color: #2563eb; margin: 10px 0;"><t t-esc="doc.warranty_type.replace('_', ' ').upper()"/></h3>
                    </div>

                    <!-- Coverage Period and Verification Token -->
                    <div style="background-color: #f3f4f6; border-radius: 8px; padding: 20px; margin: 30px auto; max-width: 600px; text-align: center; border: 1px solid #d1d5db;">
                        <div style="display: flex; justify-content: space-around; margin-bottom: 15px;">
                            <div>
                                <small style="color: #6b7280;">Duration</small>
                                <p style="font-weight: bold; margin: 0; font-size: 18px;"><t t-esc="doc.duration_years"/> Years</p>
                            </div>
                            <div>
                                <small style="color: #6b7280;">Effective Date</small>
                                <p style="font-weight: bold; margin: 0; font-size: 18px;"><t t-esc="doc.start_date"/></p>
                            </div>
                            <div>
                                <small style="color: #6b7280;">Expiration Date</small>
                                <p style="font-weight: bold; margin: 0; font-size: 18px;"><t t-esc="doc.expiry_date"/></p>
                            </div>
                        </div>
                        <div style="border-top: 1px solid #e5e7eb; padding-top: 10px;">
                            <small style="color: #6b7280;">Cryptographic Verification Token</small>
                            <p style="font-family: monospace; font-size: 16px; color: #047857; margin: 5px 0 0 0; font-weight: bold;"><t t-esc="doc.verification_hash"/></p>
                        </div>
                    </div>

                    <!-- Terms -->
                    <div style="margin: 25px 0; font-size: 13px; line-height: 1.6; color: #4b5563;">
                        <p><strong>Coverage Clause:</strong> <t t-esc="doc.terms_and_conditions or 'Guarantees performance adherence and free replacement of defective OEM hardware according to standard manufacturer warranty terms.'" /></p>
                    </div>

                    <!-- Signatures -->
                    <div style="display: flex; justify-content: space-between; margin-top: 60px;">
                        <div style="text-align: center; border-top: 1px solid #374151; width: 200px; padding-top: 5px;">
                            <p style="margin: 0; font-weight: bold;">Authorized Solar EPC Signatory</p>
                            <small>Quality Assurance Division</small>
                        </div>
                        <div style="text-align: center; border-top: 1px solid #374151; width: 200px; padding-top: 5px;">
                            <p style="margin: 0; font-weight: bold;">OEM Technical Certifier</p>
                            <small><t t-esc="doc.oem_brand"/></small>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
